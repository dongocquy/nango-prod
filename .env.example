# =============================================================================
# Nango Production — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# =============================================================================

# ===== ENCRYPTION KEY (required) =====
# Generate with: openssl rand -base64 32
NANGO_ENCRYPTION_KEY=<GENERATE-WITH-OPENSSL>

# ===== DATABASE =====
NANGO_DB_USER=nango
NANGO_DB_PASSWORD=nango
NANGO_DB_HOST=nango-db
NANGO_DB_PORT=5432
NANGO_DB_NAME=nango
NANGO_DB_SCHEMA=nango
NANGO_DB_SSL=false
NANGO_DB_POOL_MIN=2
NANGO_DB_POOL_MAX=20

# Records database (defaults to main DB)
RECORDS_DATABASE_URL=postgresql://nango:nango@nango-db:5432/nango

# ===== SERVER =====
SERVER_PORT=3003

# ===== PUBLIC URLs =====
# Change these to your domain when using Cloudflare Tunnel or reverse proxy
NANGO_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_SERVER_URL=http://localhost:3003
NANGO_PUBLIC_CONNECT_URL=http://localhost:3009

# ===== DASHBOARD AUTH (basic auth) =====
# Uncomment to enable simple username/password protection
# NANGO_DASHBOARD_USERNAME=admin
# NANGO_DASHBOARD_PASSWORD=your-password-here

# ===== AUTH (login/signup) =====
# Set to true to enable login/signup UI (requires WORKOS_API_KEY for email)
FLAG_AUTH_ENABLED=false

# ===== LOGGING =====
LOG_LEVEL=info
TZ=UTC

# ===== ELASTICSEARCH LOGS (optional) =====
NANGO_LOGS_ENABLED=false
NANGO_LOGS_ES_URL=http://localhost:9500

# ===== CONNECT UI =====
FLAG_SERVE_CONNECT_UI=true
NANGO_CONNECT_UI_PORT=3009
NANGO_SERVER_WEBSOCKETS_PATH=/

# ===== ROLE-BASED AUTHORIZATION (optional) =====
FLAG_AUTH_ROLES_ENABLED=false

# ===== TELEMETRY (Datadog — optional) =====
NANGO_TELEMETRY_SDK=false

# ===== WORKOS (Hosted Auth — optional) =====
# WORKOS_API_KEY=
# WORKOS_CLIENT_ID=

# ===== MAILGUN (optional) =====
# MAILGUN_API_KEY=
# MAILGUN_URL=

# ===== CLICKHOUSE (optional) =====
# CLICKHOUSE_URL=http://default:@clickhouse:8123
